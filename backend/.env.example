# Скопируйте в .env и задайте свои значения для локальной разработки.
POSTGRES_PASSWORD=change-me

# Секрет ключа API локального LiveKit (имя ключа — devkey). Случайная строка от 32 символов.
# То же значение нужно задать приложению: dotnet user-secrets set "LiveKit:ApiSecret" "<то же значение>"
LIVEKIT_API_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
