{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Maintenance": {
    "Notifications": {
      "ReadRetentionDays": 90,
      "UnreadRetentionDays": 180,
      "BatchSize": 1000,
      "MaxBatchesPerRun": 100
    },
    "BucketReconciliation": {
      "DeleteOrphans": false,
      "MinAgeHours": 24,
      "MaxOrphansPerRun": 1000,
      "CheckBatchSize": 500
    }
  },
  "Turnstile": {
    "Enabled": true,
    "TimeoutSeconds": 5,
    "SendClientIp": false
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173",
    "RequestsPath": "/requests",
    "ExchangePath": "/exchanges/{id}"
  },
  "RateLimiting": {
    "Enabled": true,
    "MailPerEmail": { "PermitLimit": 3, "WindowSeconds": 3600 },
    "MailPerIp": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "LoginPerIp": { "PermitLimit": 10, "WindowSeconds": 60 },
    "RegisterPerIp": { "PermitLimit": 5, "WindowSeconds": 3600 },
    "ResetPasswordPerIp": { "PermitLimit": 10, "WindowSeconds": 3600 },
    "ConfirmEmailPerIp": { "PermitLimit": 20, "WindowSeconds": 3600 },
    "RefreshPerIp": { "PermitLimit": 30, "WindowSeconds": 60 },
    "SuggestionsPerUser": { "PermitLimit": 5, "WindowSeconds": 3600 },
    "AuthenticatedPerUser": { "PermitLimit": 100, "WindowSeconds": 60 }
  }
}
