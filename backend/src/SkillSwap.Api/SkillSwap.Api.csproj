<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a1394de1-173f-46e0-b66f-793abb4a65ff</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.13.1" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестовая страница LiveKit (только Development): вшита в сборку, отдаётся из DevTools/LiveKitDevTools.cs. -->
    <EmbeddedResource Include="DevTools\livekit-test.html" LogicalName="livekit-test.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkillSwap.Application\SkillSwap.Application.csproj" />
    <ProjectReference Include="..\SkillSwap.Infrastructure\SkillSwap.Infrastructure.csproj" />
  </ItemGroup>

</Project>
