# Адрес API бэкенда (по ТЗ префикс /api/v1).
# Когда бэкенд запущен, укажи его адрес, например: http://localhost:5000/api/v1
VITE_API_URL=/api/v1

# true = работаем на заглушках (mock), false = настоящие запросы к бэкенду
VITE_USE_MOCKS=true

# Ключ сайта Cloudflare Turnstile. Если не указан, используется тестовый 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Только разработка: dev-сервер по HTTPS для проверки с другого устройства в сети (камера, микрофон и Secure-cookie
# работают лишь на https или localhost). Пути к PEM-файлам самоподписанного сертификата, файлы держи вне репозитория.
# Как выпустить сертификат и что задать бэкенду: docs/BACKEND-DEV.md, раздел «Проверка с другого устройства по HTTPS».
# DEV_HTTPS_KEY=/Users/<you>/.skillswap/dev-https/key.pem
# DEV_HTTPS_CERT=/Users/<you>/.skillswap/dev-https/cert.pem
